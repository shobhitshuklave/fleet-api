# --- MongoDB ---
# Cluster: tradepillr.3bsch.mongodb.net (from your Atlas screenshot)
# Database: tradepillr_qats
# Replace <password> with the actual password for tradepillr-local-qats-CODEX —
# left out here intentionally so it isn't sitting in a plain file on disk.
MONGODB_URI=mongodb+srv://tradepillr-local-qats-CODEX:<password>@tradepillr.3bsch.mongodb.net/tradepillr_qats?retryWrites=true&w=majority
MONGODB_DB_NAME=tradepillr_qats

# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins (your Lovable preview + prod URL)
ALLOWED_ORIGINS=https://pixel-to-plan-wise.lovable.app,https://preview--pixel-to-plan-wise.lovable.app

# --- File storage (AWS S3 or S3-compatible, e.g. Cloudflare R2 / DigitalOcean Spaces) ---
S3_BUCKET=tradiespec-fleet-documents
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
# Only needed for non-AWS S3-compatible providers (leave blank for real AWS S3)
S3_ENDPOINT=
